#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer CountBuf { int   counts[]; };
layout(set = 0, binding = 1) readonly buffer AuxBuf   { int   aux[]; };
layout(set = 0, binding = 2) readonly buffer BgBuf    { uint  bg_rgba[]; };
layout(set = 0, binding = 3) readonly buffer CamBuf   { float cam[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf  { uint  out_rgba[]; };

layout(push_constant) uniform PC {
    uint  width;
    uint  height;
    uint  has_bg;
    uint  bg_w;
    uint  bg_h;
    uint  bg_base;
    uint  out_base;
    float alpha;
    float max_count;
    float uv_left;
    float uv_top;
    float uv_right;
    float uv_bottom;
} p;

vec3 unpack_rgb(uint packed) {
    return vec3(
        float(packed & 0xFFu),
        float((packed >> 8u) & 0xFFu),
        float((packed >> 16u) & 0xFFu)
    );
}

vec3 sample_bg_uv(float u, float v) {
    float fx = mix(p.uv_left, p.uv_right, u) * float(p.bg_w) - 0.5;
    float fy = mix(p.uv_top, p.uv_bottom, v) * float(p.bg_h) - 0.5;
    float cx = clamp(fx, 0.0, float(p.bg_w - 1u));
    float cy = clamp(fy, 0.0, float(p.bg_h - 1u));
    uint x0 = uint(floor(cx));
    uint y0 = uint(floor(cy));
    uint x1 = min(x0 + 1u, p.bg_w - 1u);
    uint y1 = min(y0 + 1u, p.bg_h - 1u);
    float tx = cx - float(x0);
    float ty = cy - float(y0);
    vec3 c00 = unpack_rgb(bg_rgba[p.bg_base + y0 * p.bg_w + x0]);
    vec3 c10 = unpack_rgb(bg_rgba[p.bg_base + y0 * p.bg_w + x1]);
    vec3 c01 = unpack_rgb(bg_rgba[p.bg_base + y1 * p.bg_w + x0]);
    vec3 c11 = unpack_rgb(bg_rgba[p.bg_base + y1 * p.bg_w + x1]);
    return mix(mix(c00, c10, tx), mix(c01, c11, tx), ty);
}

void main() {
    uint total = p.width * p.height;
    uint stride = gl_NumWorkGroups.x * 256u;

    vec3 cam_pos = vec3(cam[0], cam[1], cam[2]);
    vec3 rgt     = vec3(cam[3], cam[4], cam[5]);
    vec3 up      = vec3(cam[6], cam[7], cam[8]);
    vec3 fwd     = vec3(cam[9], cam[10], cam[11]);
    float focal  = cam[18];
    float aspect = cam[19];

    bool is_spheres = (p.max_count < 0.0);
    float inv_log_max = 1.0 / max(log(1.0 + max(p.max_count, 1.0)), 1e-6);

    for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
        uint py = i / p.width;
        uint px = i - py * p.width;

        float ndc_x = ((float(px) + 0.5) / float(p.width)) * 2.0 - 1.0;
        float ndc_y = 1.0 - ((float(py) + 0.5) / float(p.height)) * 2.0;

        if (is_spheres) {
            int packed = counts[i];
            vec3 rgb;
            if (packed != 0x7FFFFFFF) {
                uint up = uint(packed);
                rgb = vec3(
                    float(((up >> 14u) & 0x3Fu) << 2u),
                    float(((up >> 7u) & 0x7Fu) << 1u),
                    float((up & 0x7Fu) << 1u)
                );
            } else {
                float rad = clamp(length(vec2(ndc_x, ndc_y)) * 0.72, 0.0, 1.0);
                rgb = mix(vec3(24.0, 29.0, 42.0), vec3(8.0, 10.0, 16.0), rad);
            }
            uvec3 q = uvec3(clamp(round(rgb), vec3(0.0), vec3(255.0)));
            out_rgba[p.out_base + i] = q.r | (q.g << 8u) | (q.b << 16u) | 0xFF000000u;
            continue;
        }

        // Subtle dark space/horizon gradient
        vec3 bg = mix(vec3(8.0, 11.0, 18.0), vec3(18.0, 24.0, 38.0), clamp(0.5 - ndc_y * 0.5, 0.0, 1.0));

        // Intersect ray with tilted ground plane z = 0
        vec3 ray_dir = normalize(fwd + rgt * (ndc_x * aspect / focal) + up * (ndc_y / focal));
        if (ray_dir.z < -1e-4) {
            float t = -cam_pos.z / ray_dir.z;
            if (t > 0.0 && t < 30.0) {
                vec2 hit = cam_pos.xy + ray_dir.xy * t;
                if (abs(hit.x) <= 1.0 && abs(hit.y) <= 1.0) {
                    float u = hit.x * 0.5 + 0.5;
                    float v = 0.5 - hit.y * 0.5;
                    vec3 ground;
                    if (p.has_bg != 0u && p.bg_w > 0u && p.bg_h > 0u) {
                        // Slightly darken satellite map so glowing 3D trajectories pop
                        ground = sample_bg_uv(u, v) * 0.62;
                    } else {
                        ground = vec3(16.0, 20.0, 30.0);
                    }
                    // Subtle coordinate grid on ground plane
                    float gx = abs(fract(hit.x * 4.0 + 0.5) - 0.5);
                    float gy = abs(fract(hit.y * 4.0 + 0.5) - 0.5);
                    if (gx < 0.012 || gy < 0.012) {
                        ground = mix(ground, vec3(70.0, 95.0, 130.0), 0.35);
                    }
                    // Crisp glowing border around the ROI
                    if (abs(hit.x) > 0.992 || abs(hit.y) > 0.992) {
                        ground = vec3(90.0, 145.0, 210.0);
                    }
                    float fog = clamp(1.0 - (t - 2.5) / 14.0, 0.35, 1.0);
                    bg = mix(bg, ground, fog);
                }
            }
        }

        vec3 rgb = bg;
        int c = counts[i];
        if (c > 0) {
            uint b3 = i * 3u;
            vec3 fg = vec3(float(aux[b3 + 0u]), float(aux[b3 + 1u]), float(aux[b3 + 2u])) / float(c);
            float intensity = clamp(log(1.0 + float(c)) * inv_log_max, 0.0, 1.0);
            // Volumetric boost: dense corridors brighten slightly toward white-gold
            fg = mix(fg, vec3(255.0, 250.0, 225.0), intensity * 0.25);
            float a = mix(0.42 * p.alpha, p.alpha, intensity);
            rgb = mix(rgb, fg, a);
        }

        uvec3 q = uvec3(clamp(round(rgb), vec3(0.0), vec3(255.0)));
        out_rgba[p.out_base + i] = q.r | (q.g << 8u) | (q.b << 16u) | 0xFF000000u;
    }
}
