#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer XBuf { float xs[]; };
layout(set = 0, binding = 1) readonly buffer YBuf { float ys[]; };
layout(set = 0, binding = 2) buffer OutBuf { int grid[]; };

layout(push_constant) uniform PC {
    uint n;
    uint width;
    uint height;
    uint flip_y;
    uint x_base;
    uint y_base;
    uint out_base;
    float xmin;
    float inv_dx;
    float ymin;
    float ymax;
    float inv_dy;
} p;

void main() {
    uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride) {
        float xv = xs[p.x_base + i];
        float yv = ys[p.y_base + i];
        float u = (xv - p.xmin) * p.inv_dx;
        float v = (p.flip_y != 0u) ? ((p.ymax - yv) * p.inv_dy) : ((yv - p.ymin) * p.inv_dy);
        if (u >= 0.0 && u < 1.0 && v >= 0.0 && v < 1.0) {
            uint px = min(uint(u * float(p.width)), p.width - 1u);
            uint py = min(uint(v * float(p.height)), p.height - 1u);
            atomicAdd(grid[p.out_base + py * p.width + px], 1);
        }
    }
}
