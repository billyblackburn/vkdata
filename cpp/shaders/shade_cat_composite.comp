#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer CountBuf { int  counts[]; };
layout(set = 0, binding = 1) readonly buffer AuxBuf   { int  aux[]; };
layout(set = 0, binding = 2) readonly buffer BgBuf    { uint bg_rgba[]; };
layout(set = 0, binding = 3) writeonly buffer OutBuf  { uint out_rgba[]; };

layout(push_constant) uniform PC {
    uint  width;
    uint  height;
    uint  mode;      // 1=mean_fire, 2=mean_fire_r, 3=cat_rgb
    uint  has_bg;
    uint  bg_w;
    uint  bg_h;
    uint  bg_base;
    uint  out_base;
    float alpha;
    float vmin;
    float vmax;
    float uv_left;
    float uv_top;
    float uv_right;
    float uv_bottom;
} p;

vec3 unpack_rgb(uint packed) {
    return vec3(
        float(packed & 0xFFu),
        float((packed >> 8u) & 0xFFu),
        float((packed >> 16u) & 0xFFu)
    );
}

vec3 sample_bg_bilinear(uint px, uint py) {
    if (p.has_bg == 0u || p.bg_w == 0u || p.bg_h == 0u) {
        return vec3(0.0, 0.0, 0.0);
    }
    float fx = mix(p.uv_left, p.uv_right, (float(px) + 0.5) / float(p.width)) * float(p.bg_w) - 0.5;
    float fy = mix(p.uv_top, p.uv_bottom, (float(py) + 0.5) / float(p.height)) * float(p.bg_h) - 0.5;

    float cx = clamp(fx, 0.0, float(p.bg_w - 1u));
    float cy = clamp(fy, 0.0, float(p.bg_h - 1u));

    uint x0 = uint(floor(cx));
    uint y0 = uint(floor(cy));
    uint x1 = min(x0 + 1u, p.bg_w - 1u);
    uint y1 = min(y0 + 1u, p.bg_h - 1u);
    float tx = cx - float(x0);
    float ty = cy - float(y0);

    vec3 c00 = unpack_rgb(bg_rgba[p.bg_base + y0 * p.bg_w + x0]);
    vec3 c10 = unpack_rgb(bg_rgba[p.bg_base + y0 * p.bg_w + x1]);
    vec3 c01 = unpack_rgb(bg_rgba[p.bg_base + y1 * p.bg_w + x0]);
    vec3 c11 = unpack_rgb(bg_rgba[p.bg_base + y1 * p.bg_w + x1]);

    return mix(mix(c00, c10, tx), mix(c01, c11, tx), ty);
}

vec3 fire_colormap(float s) {
    s = clamp(s, 0.0, 1.0);
    if (s < 0.18) return mix(vec3(0.0, 0.0, 0.0),     vec3(60.0, 0.0, 20.0),    s / 0.18);
    if (s < 0.36) return mix(vec3(60.0, 0.0, 20.0),   vec3(145.0, 10.0, 10.0),  (s - 0.18) / 0.18);
    if (s < 0.55) return mix(vec3(145.0, 10.0, 10.0), vec3(220.0, 65.0, 0.0),   (s - 0.36) / 0.19);
    if (s < 0.74) return mix(vec3(220.0, 65.0, 0.0),  vec3(255.0, 155.0, 0.0),  (s - 0.55) / 0.19);
    if (s < 0.89) return mix(vec3(255.0, 155.0, 0.0), vec3(255.0, 230.0, 80.0), (s - 0.74) / 0.15);
    return mix(vec3(255.0, 230.0, 80.0), vec3(255.0, 255.0, 255.0), (s - 0.89) / 0.11);
}

void main() {
    uint total = p.width * p.height;
    uint stride = gl_NumWorkGroups.x * 256u;

    for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
        uint py = i / p.width;
        uint px = i - py * p.width;
        vec3 rgb = sample_bg_bilinear(px, py);

        int c = counts[i];
        if (c > 0) {
            if (p.mode == 3u) {
                uint b3 = i * 3u;
                vec3 fg = vec3(float(aux[b3 + 0u]), float(aux[b3 + 1u]), float(aux[b3 + 2u])) / float(c);
                float intensity = log(1.0 + float(c)) / max(log(1.0 + max(p.vmax, 1.0)), 1e-6);
                float a = mix(0.45 * p.alpha, p.alpha, clamp(intensity, 0.0, 1.0));
                rgb = mix(rgb, fg, a);
            } else {
                float mean_val = (float(aux[i]) / 256.0) / float(c);
                float s = clamp((mean_val - p.vmin) / max(p.vmax - p.vmin, 1e-6), 0.0, 1.0);
                if (p.mode == 2u) {
                    s = 1.0 - s;
                }
                vec3 fg = fire_colormap(s);
                rgb = mix(rgb, fg, p.alpha);
            }
        }

        uvec3 q = uvec3(clamp(round(rgb), vec3(0.0), vec3(255.0)));
        out_rgba[p.out_base + i] = q.r | (q.g << 8u) | (q.b << 16u) | 0xFF000000u;
    }
}
