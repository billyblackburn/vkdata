#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer SrcPM    { vec4  src_pm[]; };
layout(set = 0, binding = 1) readonly buffer SrcVG    { vec4  src_vg[]; };
layout(set = 0, binding = 2) writeonly buffer DstPM   { vec4  dst_pm[]; };
layout(set = 0, binding = 3) writeonly buffer DstVG   { vec4  dst_vg[]; };
layout(set = 0, binding = 4) readonly buffer Heads    { int   leaf_heads[]; };
layout(set = 0, binding = 5) readonly buffer NextBuf  { int   particle_next[]; };
layout(set = 0, binding = 6) readonly buffer TreeCom  { vec4  tree_com[]; };
layout(set = 0, binding = 7) readonly buffer TreeSz   { float tree_size[]; };

layout(push_constant) uniform PC {
    uint  n;
    uint  leaf_offset;
    float G;
    float softening_sq;
    float dt;
    float damping;
    float theta_sq;
    float restitution;
    float world_half;
} p;

uint expand_bits_5(uint v) {
    uint x = v & 0x1Fu;
    x = (x | (x << 8u)) & 0x0000F00Fu;
    x = (x | (x << 4u)) & 0x000C30C3u;
    x = (x | (x << 2u)) & 0x00249249u;
    return x;
}

uint morton3d_5bit(vec3 pos, float wh) {
    vec3 norm = clamp((pos + vec3(wh)) / (2.0 * wh), vec3(0.0), vec3(0.9999));
    uvec3 u = uvec3(norm * 32.0);
    return expand_bits_5(u.x) | (expand_bits_5(u.y) << 1u) | (expand_bits_5(u.z) << 2u);
}

float particle_radius(float mass) {
    if (mass > 100.0) return 0.85;
    return 0.14 * pow(max(mass, 1e-4), 0.3333333);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    vec4 self_pm = src_pm[i];
    vec4 self_vg = src_vg[i];
    vec3 p_i = self_pm.xyz;
    float m_i = self_pm.w;
    vec3 v_i = self_vg.xyz;
    float gal_raw = self_vg.w;
    float gal_id = floor(gal_raw);
    float flash = fract(gal_raw) * 0.92;
    float r_i = particle_radius(m_i);

    vec3 acc = vec3(0.0);
    vec3 dv_col = vec3(0.0);
    vec3 dp_col = vec3(0.0);

    uint stack[48];
    uint sp = 0u;
    for (uint c = 0u; c < 8u; ++c) {
        uint child = 1u + c;
        if (tree_com[child].w > 0.0) {
            stack[sp++] = child;
        }
    }

    uint guard = 0u;
    while (sp > 0u && guard < 512u) {
        guard += 1u;
        uint node = stack[--sp];
        vec4 com = tree_com[node];
        if (com.w <= 0.0) continue;

        vec3 diff = com.xyz - p_i;
        float dist_sq = dot(diff, diff) + p.softening_sq;
        float s = tree_size[node];

        if (node >= p.leaf_offset || s * s < p.theta_sq * dist_sq) {
            float inv_d = inversesqrt(dist_sq);
            acc += diff * (com.w * inv_d * inv_d * inv_d);
        } else {
            uint fc = node * 8u + 1u;
            for (uint c = 0u; c < 8u; ++c) {
                uint child = fc + c;
                if (tree_com[child].w > 0.0 && sp < 48u) {
                    stack[sp++] = child;
                }
            }
        }
    }

    // Near-field elastic sphere-sphere collision detection in particle i's Morton leaf cell
    if (m_i < 100.0) {
        uint my_leaf = morton3d_5bit(p_i, p.world_half);
        int cur = leaf_heads[my_leaf];
        uint lit = 0u;
        while (cur != -1 && lit < 24u) {
            uint j = uint(cur);
            cur = particle_next[j];
            lit += 1u;
            if (j == i) continue;

            vec4 opm = src_pm[j];
            vec3 r_diff = opm.xyz - p_i;
            float r2_raw = dot(r_diff, r_diff);
            float r_sum = r_i + particle_radius(opm.w);
            if (r2_raw < r_sum * r_sum && r2_raw > 1e-6) {
                float dist = sqrt(r2_raw);
                vec3 normal = r_diff / dist;
                float overlap = r_sum - dist;
                float mass_ratio = clamp(opm.w / (m_i + opm.w), 0.05, 0.95);
                dp_col -= normal * (overlap * 0.35 * mass_ratio);

                vec3 rel_vel = v_i - src_vg[j].xyz;
                float v_norm = dot(rel_vel, normal);
                if (v_norm > 0.0) {
                    dv_col -= normal * ((1.0 + p.restitution) * mass_ratio * v_norm);
                    flash = 0.98;
                }
            }
        }
    }

    vec3 new_vel = (v_i + (p.G * acc) * p.dt + dv_col) * p.damping;
    vec3 new_pos = p_i + new_vel * p.dt + dp_col;
    if (m_i > 100.0) {
        new_vel = (v_i + (p.G * acc) * p.dt) * p.damping;
        new_pos = p_i + new_vel * p.dt;
    }

    dst_pm[i] = vec4(new_pos, m_i);
    dst_vg[i] = vec4(new_vel, gal_id + clamp(flash, 0.0, 0.99));
}
