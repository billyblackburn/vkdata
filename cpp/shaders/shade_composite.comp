#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer GridBuf  { int counts[]; };
layout(set = 0, binding = 1) readonly buffer StatsBuf { uint stats[]; };
layout(set = 0, binding = 2) readonly buffer CdfBuf   { float cdf[]; };
layout(set = 0, binding = 3) readonly buffer BgBuf    { uint bg_rgba[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf  { uint out_rgba[]; };
layout(set = 0, binding = 5) readonly buffer LutBuf   { uint lut_rgba[]; };

layout(push_constant) uniform PC {
    uint width;
    uint height;
    uint how;       // 0=eq_hist, 1=log, 2=cbrt, 3=linear
    uint has_bg;
    uint bg_w;
    uint bg_h;
    uint grid_base;
    uint bg_base;
    uint out_base;
    uint spread_px; // 0=off, 1..3=radius px, 0xFFFFFFFF=auto dynspread
    float alpha;    // [0..1]
    float uv_left;
    float uv_top;
    float uv_right;
    float uv_bottom;
} p;

vec3 unpack_rgb(uint packed) {
    return vec3(
        float(packed & 0xFFu),
        float((packed >> 8u) & 0xFFu),
        float((packed >> 16u) & 0xFFu)
    );
}

vec3 sample_bg_bilinear(uint px, uint py) {
    if (p.has_bg == 0u || p.bg_w == 0u || p.bg_h == 0u) {
        return vec3(10.0, 10.0, 14.0);
    }
    float fx = mix(p.uv_left, p.uv_right, (float(px) + 0.5) / float(p.width)) * float(p.bg_w) - 0.5;
    float fy = mix(p.uv_top, p.uv_bottom, (float(py) + 0.5) / float(p.height)) * float(p.bg_h) - 0.5;

    float cx = clamp(fx, 0.0, float(p.bg_w - 1u));
    float cy = clamp(fy, 0.0, float(p.bg_h - 1u));

    uint x0 = uint(floor(cx));
    uint y0 = uint(floor(cy));
    uint x1 = min(x0 + 1u, p.bg_w - 1u);
    uint y1 = min(y0 + 1u, p.bg_h - 1u);
    float tx = cx - float(x0);
    float ty = cy - float(y0);

    vec3 c00 = unpack_rgb(bg_rgba[p.bg_base + y0 * p.bg_w + x0]);
    vec3 c10 = unpack_rgb(bg_rgba[p.bg_base + y0 * p.bg_w + x1]);
    vec3 c01 = unpack_rgb(bg_rgba[p.bg_base + y1 * p.bg_w + x0]);
    vec3 c11 = unpack_rgb(bg_rgba[p.bg_base + y1 * p.bg_w + x1]);

    return mix(mix(c00, c10, tx), mix(c01, c11, tx), ty);
}

vec3 sample_lut(float s) {
    float f = clamp(s, 0.0, 1.0) * 255.0;
    uint i0 = uint(floor(f));
    uint i1 = min(i0 + 1u, 255u);
    return mix(unpack_rgb(lut_rgba[i0]), unpack_rgb(lut_rgba[i1]), f - float(i0));
}

void main() {
    uint total = p.width * p.height;
    uint stride = gl_NumWorkGroups.x * 256u;
    float max_v = max(float(stats[2048]), 1.0);

    // Resolve spread radius (0 = off, 1..3 = fixed, 0xFFFFFFFF = GPU auto dynspread)
    int r = 0;
    if (p.spread_px == 0xFFFFFFFFu) {
        float density = float(stats[2049]) / max(float(total), 1.0);
        if (density < 0.005) r = 2;
        else if (density < 0.035) r = 1;
    } else {
        r = int(min(p.spread_px, 3u));
    }

    for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
        uint py = i / p.width;
        uint px = i - py * p.width;
        vec3 rgb = sample_bg_bilinear(px, py);

        int c = counts[p.grid_base + i];
        if (r > 0) {
            int ix = int(px);
            int iy = int(py);
            int iw = int(p.width);
            int ih = int(p.height);
            int r2 = r * r;
            for (int dy = -r; dy <= r; ++dy) {
                int ny = iy + dy;
                if (ny < 0 || ny >= ih) continue;
                int row_off = ny * iw;
                for (int dx = -r; dx <= r; ++dx) {
                    if (dx * dx + dy * dy > r2) continue;
                    int nx = ix + dx;
                    if (nx < 0 || nx >= iw) continue;
                    c = max(c, counts[p.grid_base + uint(row_off + nx)]);
                }
            }
        }
        if (c > 0) {
            float v = float(c);
            float s = 0.0;
            if (p.how == 0u) {
                uint b = min(uint(log2(1.0 + v) * (2047.0 / 24.0)), 2047u);
                s = cdf[b];
            } else if (p.how == 1u) {
                s = log(1.0 + v) / log(1.0 + max_v);
            } else if (p.how == 2u) {
                s = pow(v, 1.0 / 3.0) / pow(max_v, 1.0 / 3.0);
            } else {
                s = v / max_v;
            }
            vec3 fg = sample_lut(s);
            rgb = mix(rgb, fg, p.alpha);
        }

        uvec3 q = uvec3(clamp(round(rgb), vec3(0.0), vec3(255.0)));
        out_rgba[p.out_base + i] = q.r | (q.g << 8u) | (q.b << 16u) | 0xFF000000u;
    }
}
