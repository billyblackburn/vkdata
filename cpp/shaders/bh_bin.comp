#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer SrcPM    { vec4 pos_mass[]; };
layout(set = 0, binding = 1) buffer LeafHeads         { int  leaf_heads[]; };
layout(set = 0, binding = 2) writeonly buffer NextBuf { int  particle_next[]; };

layout(push_constant) uniform PC {
    uint  n;
    float world_half;
} p;

uint expand_bits_5(uint v) {
    uint x = v & 0x1Fu;
    x = (x | (x << 8u)) & 0x0000F00Fu;
    x = (x | (x << 4u)) & 0x000C30C3u;
    x = (x | (x << 2u)) & 0x00249249u;
    return x;
}

uint morton3d_5bit(vec3 pos, float wh) {
    vec3 norm = clamp((pos + vec3(wh)) / (2.0 * wh), vec3(0.0), vec3(0.9999));
    uvec3 u = uvec3(norm * 32.0);
    return expand_bits_5(u.x) | (expand_bits_5(u.y) << 1u) | (expand_bits_5(u.z) << 2u);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint leaf_idx = morton3d_5bit(pos_mass[i].xyz, p.world_half);
    int old_head = atomicExchange(leaf_heads[leaf_idx], int(i));
    particle_next[i] = old_head;
}
